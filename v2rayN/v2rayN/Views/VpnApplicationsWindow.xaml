<Window x:Class="v2rayN.Views.VpnApplicationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="برنامه‌های دلخواه" Width="690" Height="530" MinWidth="480" MinHeight="350"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource WindowGlobal}" FlowDirection="RightToLeft">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="برنامه‌هایی را که باید از وی‌پی‌ان استفاده کنند انتخاب کنید." TextWrapping="Wrap" />
            <TextBox x:Name="SearchBox" Margin="0,12,0,12" TextChanged="Search_TextChanged"
                     AutomationProperties.Name="جستجوی برنامه"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                     materialDesign:HintAssist.Hint="جستجوی برنامه" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="اعمال" Click="Save_Click" IsDefault="True" IsEnabled="False" />
            <Button Content="افزودن فایل اجرایی…" Margin="8,0" Click="Browse_Click" Style="{StaticResource MaterialDesignOutlinedButton}" />
            <Button Content="لغو" IsCancel="True" Style="{StaticResource MaterialDesignOutlinedButton}" />
        </StackPanel>
        <TextBlock x:Name="DirectoryStatus" DockPanel.Dock="Top" Text="در حال خواندن فهرست برنامه‌ها…" Margin="0,0,0,8" />
        <ListBox x:Name="ApplicationList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Margin="4" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="Application_Click">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Path}" FlowDirection="LeftToRight" Opacity=".72" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
